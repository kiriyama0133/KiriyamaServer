{
  "app": {
    "name": "WebApi",
    "service": "webapi",
    "instance": "1",
    "version": "v1.0",
    "displayBanner": true,
    "displayVersion": true
  },
  "Kestrel": {
    "Port": 5000
  },
  "logger": {
    "level": "debug",
    "excludePaths": [
      "/",
      "/healthz",
      "/alive",
      "/metrics"
    ],
    "excludeProperties": [
      "api_key",
      "access_key",
      "ApiKey",
      "ApiSecret",
      "ClientId",
      "ClientSecret",
      "ConnectionString",
      "Password",
      "Email",
      "Login",
      "Secret",
      "Token"
    ],
    "console": {
      "enabled": true,
      "enableTracing": true
    },
    "file": {
      "enabled": true,
      "path": "logs/logs.txt",
      "interval": "day"
    },
    "tags": {}
  },
  "openApi": {
    "enabled": true,
    "reDocEnabled": true,
    "name": "WebApi",
    "title": "WebApi",
    "version": "v2",
    "description": "The WebApi",
    "routePrefix": "swagger",
    "contactName": "Giovanni Nocco",
    "contactEmail": "giovanni.nocco@genocs.com",
    "contactUrl": "https://www.genocs.com",
    "licenseName": "Use under MIT",
    "licenseUrl": "https://opensource.org/license/mit",
    "termsOfService": "https://www.genocs.com/terms_and_conditions.html",
    "includeSecurity": true,
    "servers": [
      {
        "url": "https://localhost:5001",
        "description": "Local version to be used for development"
      }
    ]
  },
  "rabbitmq": {
    "HostName": "localhost",
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "AllowedHosts": "*",
  "ExternalWebServices": {
    "Order": "https://www.genocs/orders",
    "Basket": "https://www.genocs/basket"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=kiriyama;Username=kiriyama;Password=kiriyama"
  },
  "Jwt": {
    "Issuer": "KiriyamaServer",
    "Audience": "kiriyamalauncher",
    "SigningKey": "change-me-in-production-32-chars-min",
    "AccessTokenLifetimeSeconds": 3600,
    "RefreshTokenLifetimeSeconds": 604800
  },
  "ZeroTier": {
    "VirtualIp": "10.99.38.37",
    "Backend": "SelfHosted",
    "ControlUrl": "",
    "AuthToken": "",
    "NetworkId": "633e31d8a2724274",
    "RoomTagName": "room_id",
    "ApiToken": "",
    "ApiBaseUrl": "https://api.zerotier.com"
  },
  "RebusBusSettings": {
    "TransportConnection": "amqp://guest:guest@localhost:5672/",
    "QueueName": "rebus-queue"
  },
  "FeatureManagement": {
    "Transfer": true,
    "GetAccountDetailsV2": true
  },
  "AzureServiceBusSettings": {
    "QueueEndpoint": "test",
    "QueueName": "queue"
  },
  "NServiceBus": {
    "EndpointName": "Worker",
    "UsePersistence": true,
    "TransportConnectionString": "host=localhost;username=guest;password=guest",
    "PersistenceConnectionString": "mongodb://localhost",
    "PersistenceDatabase": "ParticularPersistence"
  },
  "MassTransitSettings": {
    "HostName": "localhost",
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "EPPlus": {
    "ExcelPackage": {
      "License": "NonCommercialOrganization:Genocs"
    }
  }
}